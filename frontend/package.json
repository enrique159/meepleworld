    "android:open": "cap open android"
  },
  "dependencies": {
    "@capacitor/android": "8.5.2",
    "@capacitor/core": "8.5.2",
    "@ionic/vue": "9.0.4",
    "@ionic/vue-router": "9.0.4",
    "ionicons": "8.0.13",
    "pinia": "4.0.3",
    "vue": "3.5.43",
    "vue-router": "5.3.1"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.2",
    "@vitejs/plugin-vue": "6.0.9",
    "typescript": "5.9.3",
    "vite": "8.3.1",
    "vue-tsc": "3.3.11"
  }
}
