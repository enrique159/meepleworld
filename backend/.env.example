NODE_ENV=development
PORT=3000
APP_PUBLIC_URL=http://localhost:8080
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=meepleworld_dev
DB_USER=meepleworld
DB_PASSWORD=change-this-local-password

JWT_ACCESS_SECRET=replace-this-with-a-random-secret-of-at-least-32-characters
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAME_SITE=lax

# Adaptador local simulado: escribe los mensajes de verificación/recuperación fuera de Git.
MAIL_DRIVER=filesystem
LOCAL_MAILBOX_PATH=.local/mailbox.jsonl
